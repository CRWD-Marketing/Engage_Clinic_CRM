# Where the bridge listens for Twilio's Media Streams WebSocket + health checks.
PORT=3000

# The Laravel app - must be reachable from wherever this bridge runs.
LARAVEL_BASE_URL=https://your-clinic-app.example.com
# Must match `voice.bridge.shared_secret` / VOICE_BRIDGE_SHARED_SECRET in the
# Laravel app's .env - checked on every bridge->Laravel request.
VOICE_BRIDGE_SHARED_SECRET=
LARAVEL_TIMEOUT_MS=10000

# Speech-to-text. The Laravel app defaults to AssemblyAI (config/voice.php's
# stt.driver) - this bridge's STT client talks to whichever server/API you
# point VOICE_STT_BASE_URL at directly, independent of Laravel's own choice,
# since the bridge never routes audio through Laravel. Point this at a
# faster-whisper server, or set VOICE_STT_PROVIDER=assemblyai to use the
# same AssemblyAI account as the Laravel side.
VOICE_STT_PROVIDER=faster_whisper
VOICE_STT_BASE_URL=http://127.0.0.1:8001
VOICE_STT_TIMEOUT_MS=15000
ASSEMBLYAI_API_KEY=

# Self-hosted Piper HTTP wrapper (POST /synthesize, {"text","voice"} JSON -> WAV bytes).
VOICE_TTS_BASE_URL=http://127.0.0.1:8002
VOICE_TTS_VOICE=en_US-lessac-medium
VOICE_TTS_TIMEOUT_MS=15000

# Held bridge-side (in addition to Laravel) so mid-call transfer/hangup
# still works if Laravel itself is unreachable - see src/config.js.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Last-resort human number the bridge can transfer to on its own if Laravel
# is unreachable mid-call. Optional - leave blank to just end the call with
# an apology instead in that scenario.
VOICE_EMERGENCY_HUMAN_NUMBER=

# VAD/endpointing tuning - defaults are reasonable starting points, not
# calibrated to any specific phone line/noise floor. Expect to tune
# VOICE_VAD_THRESHOLD after a few real test calls.
VOICE_VAD_THRESHOLD=400
VOICE_VAD_SILENCE_MS=700
VOICE_VAD_MIN_SPEECH_MS=250
VOICE_VAD_MAX_UTTERANCE_MS=25000
VOICE_BARGEIN_THRESHOLD=500
VOICE_BARGEIN_SUSTAINED_MS=300
VOICE_BARGEIN_ENABLED=true
