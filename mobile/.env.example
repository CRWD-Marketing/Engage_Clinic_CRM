# Copy to .env.local (not committed) and restart `npx expo start`.
#
# Address of the Laravel server as the phone sees it. Leave it unset to run
# the app on its built-in mock data.
#
#   php artisan serve --host=0.0.0.0 --port=8000     (on the PC)
#   EXPO_PUBLIC_API_URL=http://<the PC's Wi-Fi IP>:8000
#
EXPO_PUBLIC_API_URL=
